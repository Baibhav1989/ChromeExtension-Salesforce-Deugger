{
  "manifest_version": 3,
  "name": "Salesforce Debugger",
  "version": "1.0.0",
  "description": "Read Apex debug logs for the logged-in Salesforce session, with auto-refresh, SOQL highlighting, and readable errors.",
  "icons": {
    "16": "icon-16x16.png",
    "48": "icon-48x48.png",
    "128": "icon-128x128.png"
  },
  "permissions": ["storage", "cookies", "tabs", "alarms"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.sandbox.my.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.my.salesforce-setup.com/*",
    "https://*.my.site.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Salesforce Debugger",
    "default_icon": {
      "16": "icon-16x16.png",
      "48": "icon-48x48.png",
      "128": "icon-128x128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
